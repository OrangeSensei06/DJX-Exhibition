{
  "name": "mughal-times",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A two-display, gesture-led exhibition prototype",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "node scripts/prepare-biryani.mjs && node scripts/prepare-book.mjs && node scripts/prepare-architecture.mjs && node scripts/prepare-motifs.mjs && node scripts/prepare-jewels.mjs && npm run typecheck && tsc -p tsconfig.electron.json && vite build",
    "start": "node scripts/start.mjs",
    "setup:vision": "node scripts/setup-vision.mjs",
    "test": "tsx --test tests/*.test.ts && npm run test:gesture-lab",
    "check": "npm run test && npm run build",
    "test:desktop": "node scripts/start.mjs scripts/smoke.cjs --smoke-test",
    "test:chapter": "node scripts/start.mjs scripts/chapter-smoke.cjs --smoke-test",
    "test:gestures": "node scripts/start.mjs scripts/gesture-lab-smoke.cjs --smoke-test",
    "test:gesture-lab": "node tests/gesture-lab/engine.test.mjs",
    "setup:gesture-lab": "node scripts/setup-gesture-lab.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "@react-three/fiber": "9.8.2",
    "gesture-lab-vision": "npm:@mediapipe/tasks-vision@0.10.35",
    "lottie-web": "^5.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pageflip": "^2.0.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
